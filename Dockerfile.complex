# ============================================================
#  DOLFINx (complex mode) + Python 3.10 + Jupyter Lab
#  Без conda
# ============================================================

FROM dolfinx/dolfinx:v0.7.3

USER root
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# ---- Создаём пользователя fenics ----
RUN useradd -m -s /bin/bash fenics && \
    echo "fenics ALL=(ALL) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt" >> /etc/sudoers

RUN apt update && apt install -y bash

# ---- Устанавливаем утилиты и Python-библиотеки ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        git vim curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir \
        jupyterlab \
        notebook \
        ipywidgets \
        matplotlib \
        numpy \
        scipy \
        pandas \
        meshio \
        pyvista

# ---- Активируем complex mode по умолчанию ----
RUN echo "source dolfinx-complex-mode" >> /etc/bash.bashrc

# ---- Рабочая директория ----
WORKDIR /workspace
RUN mkdir -p /workspace && chown -R fenics:fenics /workspace

# ---- Порт и пользователь ----
USER fenics
EXPOSE 8888

# ---- Команда запуска Jupyter в complex mode ----
CMD ["bash", "-c", "source dolfinx-complex-mode && \
     jupyter lab --ip=0.0.0.0 --port=8888 --allow-root --NotebookApp.token='student123' --NotebookApp.password='student123'"]

